generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                  String       @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  email               String       @unique
  password            String
  role                String       @default("USER")
  /// Restaurant this user owns (admin); mutually exclusive with staff assignment for normal cases
  restaurant          Restaurant?  @relation("RestaurantOwner")
  /// Staff: restaurant they work at (MANAGER, WAITER, CASHIER)
  staffRestaurantId   String?      @db.ObjectId
  /// NoAction breaks User ↔ Restaurant cycle (owner + staff); clear staff FK in app if restaurant is removed.
  staffRestaurant     Restaurant?  @relation("RestaurantStaff", fields: [staffRestaurantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isVerified          Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  bookings            Booking[]
  reviews             Review[]
  notifications       Notification[]
  orders              Order[]
  stockTransactions   StockTransaction[]
}

model Restaurant {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  tenantId       String         @unique
  name           String
  logo           String?
  address        String
  city           String
  cuisine        String
  description    String
  /// Approx. cost for two (₹), for discovery / filters
  priceForTwo    Float?
  vegFriendly    Boolean        @default(false)
  outdoorSeating Boolean        @default(false)
  parkingAvailable Boolean      @default(false)
  acceptsCards   Boolean        @default(false)
  openTime       String
  closeTime      String
  phone          String
  gstin          String?
  fssai          String?
  status         String         @default("PENDING")
  planId         String         @db.ObjectId
  plan           Plan           @relation(fields: [planId], references: [id])
  ownerId        String         @unique @db.ObjectId
  owner          User           @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  staffMembers   User[]         @relation("RestaurantStaff")
  tables         Table[]
  timeSlots      TimeSlot[]
  bookings       Booking[]
  reviews        Review[]
  subscriptions  Subscription[]
  menuCategories MenuCategory[]
  orders         Order[]
  ingredients    Ingredient[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  stockTxs       StockTransaction[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Table {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId String      @db.ObjectId
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableNumber  String
  capacity     Int
  section      String?
  shape        String      @default("SQUARE")
  status       String      @default("AVAILABLE")
  x            Float       @default(0)
  y            Float       @default(0)
  bookings     Booking[]
  orders       Order[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model TimeSlot {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId String      @db.ObjectId
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  startTime    String
  endTime      String
  isActive     Boolean     @default(true)
  bookings     Booking[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Booking {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  userId         String         @db.ObjectId
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId   String         @db.ObjectId
  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId        String         @db.ObjectId
  table          Table          @relation(fields: [tableId], references: [id], onDelete: Cascade)
  slotId         String         @db.ObjectId
  slot           TimeSlot       @relation(fields: [slotId], references: [id], onDelete: Cascade)
  date           DateTime
  guestCount     Int
  status         String         @default("PENDING")
  specialRequest String?
  paymentStatus  String         @default("PENDING")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Plan {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  name                String         @unique
  price               Float
  maxTables           Int
  maxBookingsPerMonth Int
  features            String
  restaurants         Restaurant[]
  subscriptions       Subscription[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Subscription {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId String             @db.ObjectId
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  planId       String             @db.ObjectId
  plan         Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime
  status       String             @default("TRIAL")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Review {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  userId       String     @db.ObjectId
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String     @db.ObjectId
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MenuCategory {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId String      @db.ObjectId
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  items        MenuItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model MenuItem {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  categoryId  String       @db.ObjectId
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  image       String?
  isAvailable Boolean      @default(true)
  orderItems  OrderItem[]
  recipeIngredients MenuItemIngredient[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Order {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId   String      @db.ObjectId
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId         String?     @db.ObjectId
  user           User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tableId        String?     @db.ObjectId
  table          Table?      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  /// Kitchen + lifecycle: PENDING → PREPARING → READY → SERVED → COMPLETED (after payment)
  status         String      @default("PENDING")
  paymentStatus  String      @default("UNPAID")
  paymentMode    String?
  customerName   String?
  customerPhone  String?
  /// Delivery / online checkout address (optional)
  deliveryAddress String?
  /// Idempotency for partner webhooks, e.g. "SWIGGY:order-123"
  externalOrderRef String?
  orderType      String      @default("DINE_IN")
  subtotal       Float       @default(0)
  gstAmount      Float       @default(0)
  discountType   String?
  discountValue  Float       @default(0)
  discountAmount Float       @default(0)
  totalAmount    Float       @default(0)
  completedAt    DateTime?
  items          OrderItem[]
  stockTransactions StockTransaction[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([restaurantId, externalOrderRef])
}

model Supplier {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId   String          @db.ObjectId
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  address        String?
  /// Items or categories this supplier typically provides (free text)
  itemsNote      String?
  ingredients    Ingredient[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([restaurantId])
}

model Ingredient {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId      String               @db.ObjectId
  restaurant        Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name              String
  /// kg | L | pcs | ml
  unit              String
  currentStock      Float                @default(0)
  minStockAlert     Float                @default(0)
  costPerUnit       Float                @default(0)
  supplierId        String?              @db.ObjectId
  supplier          Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  category          String?
  recipeLinks       MenuItemIngredient[]
  stockTransactions StockTransaction[]
  purchaseLines     PurchaseOrderLine[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([restaurantId])
}

/// Recipe: quantity of ingredient used per one serving of the menu item
model MenuItemIngredient {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  menuItemId   String     @db.ObjectId
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String     @db.ObjectId
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantityUsed Float

  @@unique([menuItemId, ingredientId])
}

/// IN | OUT | WASTE | ADJUST — quantity is always positive; type defines direction
model StockTransaction {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId String      @db.ObjectId
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredientId String    @db.ObjectId
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  type         String
  quantity     Float
  note         String?
  userId       String?     @db.ObjectId
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId      String?     @db.ObjectId
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([restaurantId, createdAt])
  @@index([ingredientId])
}

model PurchaseOrder {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId String              @db.ObjectId
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplierId   String              @db.ObjectId
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status       String              @default("PENDING")
  totalCost    Float               @default(0)
  orderedAt    DateTime            @default(now())
  receivedAt   DateTime?
  lines        PurchaseOrderLine[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([restaurantId])
}

model PurchaseOrderLine {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  purchaseOrderId String        @db.ObjectId
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId    String        @db.ObjectId
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity        Float
  unitCost        Float

  @@index([purchaseOrderId])
}

model OrderItem {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String    @db.ObjectId
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String    @db.ObjectId
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String   @default("")
  quantity   Int
  price      Float
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
